                id: 'm-006',
                name: '樹海守護者 · 艾爾達',
                titleEn: 'Eldar, Treant Guardian',
                rarity: '精英',
                element: 'earth',
                elementName: '地系',
                type: '植物妖獸',
                image: 'https://images.unsplash.com/photo-1511497584788-8767611136f6?auto=format&fit=crop&w=600&q=80',
                fallbackImage: 'https://placehold.co/600x800/064e3b/22c55e?text=Earth+Treant',
                hp: 65000,
                maxHp: 200000,
                mp: 20000,
                maxMp: 100000,
                attack: 3900,
                defense: 6500,
                speed: 150,
                weakness: ['火', '砍伐'],
                lore: '古老森林的守護長老，能操縱巨大樹根纏繞敵人，擁有極高的生命回復能力。',
                skills: ['根鬚纏繞', '大地復甦', '落葉飛刃'],
                drops: ['古樹核心 (35%)', '生命之露 (50%)']
            },
            {
                id: 'm-007',
                name: '骷髏劍豪 · 遺恨者',
                titleEn: 'Skeleton Master Warden',
                rarity: '普通',
                element: 'dark',
                elementName: '暗系',
                type: '不死族',
                image: 'https://images.unsplash.com/photo-1509248961158-e54f6934749c?auto=format&fit=crop&w=600&q=80',
                fallbackImage: 'https://placehold.co/600x800/18181b/a1a1aa?text=Skeleton+Warden',
                hp: 18000,
                maxHp: 200000,
                mp: 5000,
                maxMp: 100000,
                attack: 2800,
                defense: 1900,
                speed: 340,
                weakness: ['光', '打擊'],
                lore: '戰死沙場的騎士遺骸，受黑魔法驅使復甦，依然執著於生前的劍術技巧。',
                skills: ['三連斬', '格擋破防'],
                drops: ['生鏽的大劍 (80%)', '亡靈骨粉 (90%)']
            },
            {
                id: 'm-008',
                name: '深海巨妖 · 克拉肯',
                titleEn: 'Kraken, Abyss Leviathan',
                rarity: '傳說',
                element: 'ice',
                elementName: '冰系',
                type: '海怪',
                image: 'https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&fit=crop&w=600&q=80',
                fallbackImage: 'https://placehold.co/600x800/0c4a6e/38bdf8?text=Sea+Kraken',
                hp: 98000,
                maxHp: 200000,
                mp: 55000,
                maxMp: 100000,
                attack: 6900,
                defense: 5200,
                speed: 280,
                weakness: ['雷'],
                lore: '潛伏於無底深淵的龐然巨物，無數巨大的觸手能輕鬆拖沉整支遠航艦隊。',
                skills: ['海嘯漩渦', '觸手重壓', '劇毒墨汁'],
                drops: ['深海珍珠 (20%)', '巨妖觸手 (65%)']
            }
        ];

        // 2. Rarity Styling Mapping
        const rarityBadgeStyle = {
            '神話': 'bg-gradient-to-r from-red-600 to-purple-600 text-white border border-red-400/50 shadow-red-900/50',
            '傳說': 'bg-gradient-to-r from-amber-500 to-yellow-600 text-slate-950 border border-amber-300 shadow-amber-900/50 font-black',
            '史詩': 'bg-gradient-to-r from-purple-600 to-indigo-600 text-white border border-purple-400/50',
            '精英': 'bg-gradient-to-r from-blue-600 to-cyan-600 text-white border border-blue-400/50',
            '普通': 'bg-slate-800 text-slate-300 border border-slate-600'
        };

        const elementStyle = {
            dark: { name: '暗系', bg: 'bg-purple-950/80', text: 'text-purple-300', border: 'border-purple-800', icon: 'fa-moon' },
            fire: { name: '火系', bg: 'bg-red-950/80', text: 'text-red-300', border: 'border-red-800', icon: 'fa-fire' },
            ice: { name: '冰系', bg: 'bg-sky-950/80', text: 'text-sky-300', border: 'border-sky-800', icon: 'fa-snowflake' },
            lightning: { name: '雷系', bg: 'bg-amber-950/80', text: 'text-amber-300', border: 'border-amber-800', icon: 'fa-bolt' },
            earth: { name: '地系', bg: 'bg-emerald-950/80', text: 'text-emerald-300', border: 'border-emerald-800', icon: 'fa-mountain' },
            holy: { name: '光系', bg: 'bg-yellow-950/80', text: 'text-yellow-200', border: 'border-yellow-700', icon: 'fa-sun' }
        };

        // DOM Elements
        const monsterGrid = document.getElementById('monster-grid');
        const searchInput = document.getElementById('search-input');
        const clearSearchBtn = document.getElementById('clear-search');
        const elementFilter = document.getElementById('element-filter');
        const rarityFilter = document.getElementById('rarity-filter');
        const sortOrder = document.getElementById('sort-order');
        const emptyState = document.getElementById('empty-state');
        const totalCountEl = document.getElementById('total-count');
        const mythicCountEl = document.getElementById('mythic-count');

        // Modal Elements
        const modal = document.getElementById('monster-modal');
        const modalContent = document.getElementById('modal-content');
        const closeModalBtn = document.getElementById('close-modal');

        // Initialize App
        function initApp() {
            updateStatsCounters();
            renderMonsters(monstersData);
            setupEventListeners();
        }

        // Render Monster Cards
        function renderMonsters(data) {
            monsterGrid.innerHTML = '';

            if (data.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            data.forEach(monster => {
                const elem = elementStyle[monster.element] || elementStyle.dark;
                const isSpecialGif = monster.id === 'm-001';
                const cardGlowClass = monster.rarity === '神話' ? 'card-glow-mythic' : (monster.rarity === '傳說' ? 'card-glow-legendary' : '');

                const cardHtml = `
                    <div onclick="openModal('${monster.id}')" class="group bg-fantasy-card rounded-xl border border-slate-800 hover:border-fantasy-gold/60 transition-all duration-300 hover:-translate-y-1.5 cursor-pointer overflow-hidden flex flex-col justify-between shadow-xl ${cardGlowClass}">
                        
                        <!-- Card Image Box -->
                        <div class="relative w-full aspect-[4/3] bg-slate-950 overflow-hidden">
                            <img src="${monster.image}" 
                                 onerror="this.src='${monster.fallbackImage}'" 
                                 alt="${monster.name}" 
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            
                            <!-- Overlay Gradient -->
                            <div class="absolute inset-0 bg-gradient-to-t from-fantasy-card via-transparent to-transparent opacity-90"></div>

                            <!-- Rarity Tag -->
                            <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded-full text-xs font-bold tracking-wide shadow-md ${rarityBadgeStyle[monster.rarity]}">
                                ${monster.rarity}
                            </span>

                            <!-- Element Tag -->
                            <span class="absolute top-3 right-3 px-2 py-0.5 rounded-lg text-xs font-semibold ${elem.bg} ${elem.text} border ${elem.border} backdrop-blur-sm flex items-center gap-1">
                                <i class="fa-solid ${elem.icon} text-[10px]"></i> ${elem.name}
                            </span>

                            ${isSpecialGif ? `
                            <span class="absolute bottom-2 right-2 px-2 py-0.5 bg-red-600/90 text-white text-[10px] font-bold rounded uppercase tracking-wider animate-pulse">
                                Dynamic GIF
                            </span>` : ''}
                        </div>

                        <!-- Card Body -->
                        <div class="p-4 flex-grow flex flex-col justify-between">
                            <div>
                                <span class="text-[10px] font-mono text-slate-400 block uppercase tracking-wider">${monster.titleEn}</span>
                                <h3 class="text-lg font-bold text-slate-100 group-hover:text-fantasy-gold transition-colors font-title truncate mb-2">
                                    ${monster.name}
                                </h3>
                                <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed mb-4">
                                    ${monster.lore}
                                </p>
                            </div>

                            <!-- Quick Stats Bar -->
                            <div class="grid grid-cols-3 gap-2 pt-3 border-t border-slate-800/80 text-center text-xs">
                                <div class="bg-slate-950/50 py-1.5 rounded border border-slate-800">
                                    <span class="text-[10px] text-slate-500 block">HP</span>
                                    <span class="font-bold text-red-400">${(monster.hp / 1000).toFixed(1)}k</span>
                                </div>
                                <div class="bg-slate-950/50 py-1.5 rounded border border-slate-800">
                                    <span class="text-[10px] text-slate-500 block">ATK</span>
                                    <span class="font-bold text-amber-400">${monster.attack}</span>
                                </div>
                                <div class="bg-slate-950/50 py-1.5 rounded border border-slate-800">
                                    <span class="text-[10px] text-slate-500 block">DEF</span>
                                    <span class="font-bold text-emerald-400">${monster.defense}</span>
                                </div>
                            </div>
                        </div>

                        <!-- Card Footer Action -->
                        <div class="px-4 py-2.5 bg-slate-950/60 border-t border-slate-800/50 flex items-center justify-between text-xs text-slate-400 group-hover:text-fantasy-gold transition-colors">
                            <span>檢視詳細紀錄</span>
                            <i class="fa-solid fa-arrow-right text-[10px] group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>
                `;
                monsterGrid.insertAdjacentHTML('beforeend', cardHtml);
            });
        }

        // Update Counter Badges
        function updateStatsCounters() {
            totalCountEl.textContent = monstersData.length;
            const mythicCount = monstersData.filter(m => m.rarity === '神話').length;
            mythicCountEl.textContent = mythicCount;
        }

        // Filter and Search Logic
        function filterMonsters() {
            const searchTerm = searchInput.value.trim().toLowerCase();
            const selectedElement = elementFilter.value;
            const selectedRarity = rarityFilter.value;
            const sortVal = sortOrder.value;

            let filtered = monstersData.filter(monster => {
                const matchesSearch = monster.name.toLowerCase().includes(searchTerm) ||
                                      monster.titleEn.toLowerCase().includes(searchTerm) ||
                                      monster.lore.toLowerCase().includes(searchTerm) ||
                                      monster.skills.some(s => s.toLowerCase().includes(searchTerm));

                const matchesElement = selectedElement === 'all' || monster.element === selectedElement;
                const matchesRarity = selectedRarity === 'all' || monster.rarity === selectedRarity;

                return matchesSearch && matchesElement && matchesRarity;
            });

            // Sorting
            if (sortVal === 'hp-desc') {
                filtered.sort((a, b) => b.hp - a.hp);
            } else if (sortVal === 'atk-desc') {
                filtered.sort((a, b) => b.attack - a.attack);
            } else if (sortVal === 'def-desc') {
                filtered.sort((a, b) => b.defense - a.defense);
            }

            renderMonsters(filtered);
        }

        // Event Listeners setup
        function setupEventListeners() {
            searchInput.addEventListener('input', () => {
                if (searchInput.value.length > 0) {
                    clearSearchBtn.classList.remove('hidden');
                } else {
                    clearSearchBtn.classList.add('hidden');
                }
                filterMonsters();
            });

            clearSearchBtn.addEventListener('click', () => {
                searchInput.value = '';
                clearSearchBtn.classList.add('hidden');
                filterMonsters();
            });

            elementFilter.addEventListener('change', filterMonsters);
            rarityFilter.addEventListener('change', filterMonsters);
            sortOrder.addEventListener('change', filterMonsters);

            // Modal Close Events
            closeModalBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeModal();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeModal();
            });
        }

        // Open Modal Function
        function openModal(id) {
            const monster = monstersData.find(m => m.id === id);
            if (!monster) return;

            const elem = elementStyle[monster.element] || elementStyle.dark;

            // Populate Modal Fields
            const modalImg = document.getElementById('modal-image');
            modalImg.src = monster.image;
            modalImg.onerror = () => { modalImg.src = monster.fallbackImage; };

            document.getElementById('modal-title-en').textContent = monster.titleEn;
            document.getElementById('modal-name').textContent = monster.name;
            document.getElementById('modal-lore').textContent = monster.lore;

            // Rarity & Badges
            const rarityBadge = document.getElementById('modal-rarity-badge');
            rarityBadge.textContent = monster.rarity;
            rarityBadge.className = `absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-bold shadow-lg ${rarityBadgeStyle[monster.rarity]}`;

            const elemBadge = document.getElementById('modal-element-badge');
            elemBadge.innerHTML = `<i class="fa-solid ${elem.icon}"></i> ${elem.name}`;
            elemBadge.className = `px-3 py-1.5 rounded-lg text-xs font-bold border ${elem.bg} ${elem.text} ${elem.border}`;

            document.getElementById('modal-type-badge').innerHTML = `<i class="fa-solid fa-paw"></i> ${monster.type}`;

            // Stats
            document.getElementById('modal-hp-val').textContent = `${monster.hp.toLocaleString()} / ${monster.maxHp.toLocaleString()}`;
            document.getElementById('modal-hp-bar').style.width = `${(monster.hp / monster.maxHp) * 100}%`;

            document.getElementById('modal-mp-val').textContent = `${monster.mp.toLocaleString()} / ${monster.maxMp.toLocaleString()}`;
            document.getElementById('modal-mp-bar').style.width = `${(monster.mp / monster.maxMp) * 100}%`;

            document.getElementById('modal-atk').textContent = monster.attack.toLocaleString();
            document.getElementById('modal-def').textContent = monster.defense.toLocaleString();
            document.getElementById('modal-spd').textContent = monster.speed;

            // Skills
            const skillsContainer = document.getElementById('modal-skills');
            skillsContainer.innerHTML = monster.skills.map(skill => `
                <span class="px-3 py-1 bg-slate-950 border border-slate-800 hover:border-fantasy-gold/50 rounded-lg text-xs text-slate-300 flex items-center gap-1.5">
                    <i class="fa-solid fa-bolt text-fantasy-gold text-[10px]"></i> ${skill}
                </span>
            `).join('');

            // Drops
            const dropsContainer = document.getElementById('modal-drops');
            dropsContainer.innerHTML = monster.drops.map(drop => `
                <span class="px-3 py-1 bg-amber-950/20 border border-amber-900/40 rounded-lg text-xs text-amber-200 flex items-center gap-1.5">
                    <i class="fa-solid fa-gem text-amber-400 text-[10px]"></i> ${drop}
                </span>
            `).join('');

            // Show Modal with Animation
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modalContent.classList.remove('scale-95');
            modalContent.classList.add('scale-100');
            document.body.style.overflow = 'hidden';
        }

        // Close Modal Function
        function closeModal() {
            modal.classList.add('opacity-0', 'pointer-events-none');
            modalContent.classList.remove('scale-100');
            modalContent.classList.add('scale-95');
            document.body.style.overflow = '';
        }

        // Reset All Filters
        function resetFilters() {
            searchInput.value = '';
            elementFilter.value = 'all';
            rarityFilter.value = 'all';
            sortOrder.value = 'default';
            clearSearchBtn.classList.add('hidden');
            filterMonsters();
        }

        // Run App
        window.addEventListener('DOMContentLoaded', initApp);
    </script>
</body>
</html>
